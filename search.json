---
layout: none
---
{% assign searchable = "" | split: "" %}
{% for collection in site.collections %}
  {% assign searchable = searchable | concat: collection.docs %}
{% endfor %}
{% assign searchable = searchable | concat: site.pages %}
{% assign filtered = "" | split: "" %}
{% for item in searchable %}
  {% if item.title and item.title != "" %}
    {% assign filtered = filtered | push: item %}
  {% endif %}
{% endfor %}
[{% for item in filtered %}{"title":{{ item.title | jsonify }},"url":{{ item.url | relative_url | jsonify }},"excerpt":{{ item.excerpt | default: item.description | default: "" | strip_html | strip_newlines | truncate: 200 | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
